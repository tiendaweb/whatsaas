# Infraestructura de ESTA instalación (la lee docker compose, no la aplicación).
# Copiar a deploy/.env y completar. Las claves de la app van en el .env de la raíz.

# Dominio que va a servir la aplicación. Tiene que apuntar por DNS (A) a la IP
# del servidor ANTES de levantar: Let's Encrypt valida por HTTP.
APP_DOMAIN=midominio.com

# Contraseña de Postgres. Cambiala: no dejes "postgres".
POSTGRES_PASSWORD=

# Nombres de contenedor y puertos locales. Sólo hace falta tocarlos si en el
# mismo servidor ya corre otra instalación de WhatsPro.
APP_CONTAINER=whatspro-app
POSTGRES_CONTAINER=whatspro-postgres
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=54322

# Ruta del repo en el servidor (se monta dentro del contenedor).
REPO_PATH=/root/whatsaas

# Traefik. El router tiene que ser único dentro del mismo Traefik y la red, la
# que Traefik esté mirando (`docker network ls`).
TRAEFIK_ROUTER=whatspro
TRAEFIK_NETWORK=deploy_default
TRAEFIK_CERTRESOLVER=letsencrypt

# Base de datos (rara vez se cambian)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
