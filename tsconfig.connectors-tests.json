{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "/tmp/whatsaas-connectors-tests",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "lib/plugins/grok-connector/shared/task-patch-schema.ts",
    "lib/plugins/sites/server/text-patch.ts",
    "tests/connectors/*.test.ts"
  ]
}
