{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "/tmp/whatsaas-reseller-tests",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "lib/auth/roles.ts",
    "lib/branding/constants.ts",
    "lib/payments/plugin-types.ts",
    "lib/payments/statuses.ts",
    "lib/resellers/pricing.ts",
    "tests/resellers/*.test.ts"
  ]
}
