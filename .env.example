POSTGRES_URL=postgres://postgres:postgres@localhost:54322/postgres
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***
# Clave de 32+ caracteres para cifrar credenciales de pago guardadas en BD.
# Si se omite temporalmente, se deriva de AUTH_SECRET para compatibilidad.
PAYMENT_CONFIG_ENCRYPTION_KEY=***
PAYMENT_PROVIDER=stripe
RESELLER_INGRESS_IPS=

PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

EVOLUTION_API_URL=

NEXT_PUBLIC_WEBHOOK_URL=
EVOLUTION_WEBHOOK_TOKEN=
NEXT_PUBLIC_EVOLUTION_WEBHOOK_URL=

AUTHENTICATION_API_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.com
SUPPORT_EMAIL=

# AAPP SPACE / GoBiz (la API key se guarda por equipo desde el plugin)
AAPP_SPACE_API_URL=https://aapp.space/api/gobiz/v1
CRON_SECRET=
APP_URL=http://localhost:3000

# Sitios estáticos. El slug /s/{slug} funciona sin configuración adicional.
# Para subdominios se requiere además DNS/TLS wildcard para *.whatspro.uno.
SITES_BASE_DOMAIN=whatspro.uno
SITES_RESERVED_SUBDOMAINS=chatpro,www,api,admin
READ_ONLY_API_ALLOWED_EMAILS=noelia@whatspro.uno
# sha256 of the code used to unlock /settings/developers/read-only
READ_ONLY_API_DOCS_CODE_HASH=

# Fichas de audio: transcripción + análisis de cada nota de voz entrante.
# Todas opcionales; estos son los valores por defecto.
# Equipos habilitados, separados por coma. Vacío = todos.
AUDIO_INSIGHTS_TEAM_IDS=
AUDIO_INSIGHTS_ENABLED=true
# "false" deja el análisis a pedido; por defecto cada audio se analiza al transcribirse.
AUDIO_INSIGHTS_ANALYZE=true
AUDIO_INSIGHTS_BATCH=10
AUDIO_INSIGHTS_MIN_SECONDS=3
AUDIO_INSIGHTS_MAX_SECONDS=600
AUDIO_INSIGHTS_MAX_AGE_DAYS=30
AUDIO_INSIGHTS_MONTHLY_MINUTES=600
AUDIO_INSIGHTS_MAX_ATTEMPTS=3
# Fichas de audio: qué chats NO se transcriben.
# Los grupos, las difusiones y los números del propio equipo se excluyen solos.
AUDIO_INSIGHTS_EXCLUDE_GROUPS=true
AUDIO_INSIGHTS_EXCLUDED_JIDS=
AUDIO_INSIGHTS_EXCLUDED_NAMES=

# Agente IA: zona horaria en la que hablan los clientes (turnos y recordatorios).
# Si falta se usa TZ y, en último término, America/Argentina/Buenos_Aires.
AI_CHAT_TIMEZONE=America/Argentina/Buenos_Aires

# Web push: generar con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@dominio.com
